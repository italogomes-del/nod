{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "contracts/**/*.ts",
    "core/**/*.ts",
    "db/**/*.ts",
    "http/**/*.ts",
    "drivers/**/*.ts",
    "agent/**/*.ts",
    "web/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
