{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "contracts/**/*.ts",
    "core/**/*.ts",
    "db/**/*.ts",
    "http/**/*.ts",
    "drivers/**/*.ts",
    "agent/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
